# Region-specific API key. See https://docs.recall.ai/docs/regions
RECALL_API_KEY=your_recall_api_key_here

# Must match the region your RECALL_API_KEY belongs to:
#   US East  -> https://us-east-1.recall.ai
#   US West  -> https://us-west-2.recall.ai
#   EU       -> https://eu-central-1.recall.ai
#   Japan    -> https://ap-northeast-1.recall.ai
RECALL_BASE_URL=https://us-east-1.recall.ai

# Public HTTPS URL that serves this app (e.g. your ngrok static domain).
# The bot's camera will stream this page.
PUBLIC_URL=https://your-static-domain.ngrok-free.app

PORT=8000

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Write runs/<run>-inbound.wav (mixed 16kHz PCM sent to Gemini)
RECORD_INBOUND_AUDIO=true

# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Live output voice (prebuilt names: Kore, Puck, Charon, Aoede, Fenrir, ...)
GEMINI_VOICE=Kore

# Name of a file under question_sets/ (without .yaml) that drives the
# discovery conversation.
QUESTION_SET=discovery_v1

# Per-participant RMS (0-1) below which a frame is dropped before mix.
AUDIO_GATE_THRESHOLD=0.02
